      <node oor:name="Commands">
        <node oor:name=".uno:DistributeRows" oor:op="fuse">
          <prop oor:name="Label" oor:op="fuse" oor:type="xs:string"><value xml:lang="ko">행 높이 같게</value></prop>
        </node>
        <node oor:name=".uno:SetMinimalColumnWidth" oor:op="fuse">
          <prop oor:name="Label" oor:op="fuse" oor:type="xs:string"><value xml:lang="ko">최소 열 너비</value></prop>
        </node>
