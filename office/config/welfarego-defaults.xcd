<?xml version="1.0" encoding="UTF-8"?>
<oor:data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <dependency file="main" optional="true"/>
  <dependency file="writer" optional="true"/>
  <dependency file="calc" optional="true"/>
  <dependency file="impress" optional="true"/>
  <dependency file="draw" optional="true"/>
  <dependency file="cjk" optional="true"/>
  <dependency file="registry_ko" optional="true"/>
  <dependency file="registry_en-US" optional="true"/>

  <!-- 1. 제품명 및 각 앱 영문 명칭 (Welfarego Office Document / Spreadsheet / Presentation / Draw) -->
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="Product">
      <prop oor:name="ooName" oor:op="fuse" oor:type="xs:string">
        <value>Welfarego Office</value>
      </prop>
      <prop oor:name="ooVendor" oor:op="fuse" oor:type="xs:string">
        <value>Welfarego (Derived from LibreOffice / MPL-2.0)</value>
      </prop>
    </node>
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.text.TextDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Document</value>
            <value xml:lang="en-US">Document</value>
            <value xml:lang="ko">Document</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Spreadsheet</value>
            <value xml:lang="en-US">Spreadsheet</value>
            <value xml:lang="ko">Spreadsheet</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.presentation.PresentationDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Presentation</value>
            <value xml:lang="en-US">Presentation</value>
            <value xml:lang="ko">Presentation</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.drawing.DrawingDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Draw</value>
            <value xml:lang="en-US">Draw</value>
            <value xml:lang="ko">Draw</value>
          </prop>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- 2. 모던 탭형 리본 UI (Tabbed = notebookbar.ui) 기본 활성화 -->
  <oor:component-data oor:name="ToolbarMode" oor:package="org.openoffice.Office.UI">
    <prop oor:name="ActiveWriter" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <prop oor:name="ActiveCalc" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <prop oor:name="ActiveImpress" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <prop oor:name="ActiveDraw" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <node oor:name="Applications">
      <node oor:name="Writer" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
      </node>
      <node oor:name="Calc" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
      </node>
      <node oor:name="Impress" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
      </node>
      <node oor:name="Draw" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
      </node>
    </node>
  </oor:component-data>

  <!-- 3. 모던 컬러 벡터 아이콘(Sukapura SVG) 기본 적용 및 초기 팝업 비활성화 -->
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <prop oor:name="SymbolStyle" oor:op="fuse" oor:type="xs:string">
        <value>sukapura_svg</value>
      </prop>
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse" oor:type="xs:boolean">
        <value>false</value>
      </prop>
      <prop oor:name="ShowDonation" oor:op="fuse" oor:type="xs:boolean">
        <value>false</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
