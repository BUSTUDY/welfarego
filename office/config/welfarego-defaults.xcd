<?xml version="1.0" encoding="UTF-8"?>
<oor:data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <dependency file="main" optional="true"/>
  <dependency file="writer" optional="true"/>
  <dependency file="calc" optional="true"/>
  <dependency file="impress" optional="true"/>
  <dependency file="draw" optional="true"/>
  <dependency file="cjk" optional="true"/>

  <!-- 1. 제품명·영문 앱명·한국어 UI 기본화 및 영문 초기 환영창 비활성화 -->
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="Product">
      <prop oor:name="ooName" oor:op="fuse" oor:type="xs:string">
        <value>Welfarego Office</value>
      </prop>
      <prop oor:name="ooVendor" oor:op="fuse" oor:type="xs:string">
        <value>Welfarego (Derived from LibreOffice / MPL-2.0)</value>
      </prop>
      <prop oor:name="WhatsNew" oor:op="fuse" oor:type="xs:boolean">
        <value>false</value>
      </prop>
      <prop oor:name="WhatsNewDialog" oor:op="fuse" oor:type="xs:boolean">
        <value>false</value>
      </prop>
    </node>
    <node oor:name="L10N">
      <prop oor:name="ooLocale" oor:op="fuse" oor:type="xs:string">
        <value>ko</value>
      </prop>
    </node>
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.text.TextDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Document</value>
            <value xml:lang="en-US">Document</value>
            <value xml:lang="ko">Document</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Spreadsheet</value>
            <value xml:lang="en-US">Spreadsheet</value>
            <value xml:lang="ko">Spreadsheet</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.presentation.PresentationDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Presentation</value>
            <value xml:lang="en-US">Presentation</value>
            <value xml:lang="ko">Presentation</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.drawing.DrawingDocument" oor:op="fuse">
          <prop oor:name="ooSetupFactoryUIName" oor:op="fuse" oor:type="xs:string">
            <value>Draw</value>
            <value xml:lang="en-US">Draw</value>
            <value xml:lang="ko">Draw</value>
          </prop>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- 2. 모던 탭형 리본 UI (notebookbar.ui) + 상단 전체 메뉴바 동시 표시 (메뉴 누락 제로) -->
  <oor:component-data oor:name="ToolbarMode" oor:package="org.openoffice.Office.UI">
    <prop oor:name="ActiveWriter" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <prop oor:name="ActiveCalc" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <prop oor:name="ActiveImpress" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <prop oor:name="ActiveDraw" oor:op="fuse" oor:type="xs:string">
      <value>notebookbar.ui</value>
    </prop>
    <node oor:name="Applications">
      <node oor:name="Writer" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
        <node oor:name="Modes">
          <node oor:name="Tabbed" oor:op="fuse">
            <prop oor:name="HasMenubar" oor:op="fuse" oor:type="xs:boolean">
              <value>true</value>
            </prop>
          </node>
        </node>
      </node>
      <node oor:name="Calc" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
        <node oor:name="Modes">
          <node oor:name="Tabbed" oor:op="fuse">
            <prop oor:name="HasMenubar" oor:op="fuse" oor:type="xs:boolean">
              <value>true</value>
            </prop>
          </node>
        </node>
      </node>
      <node oor:name="Impress" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
        <node oor:name="Modes">
          <node oor:name="Tabbed" oor:op="fuse">
            <prop oor:name="HasMenubar" oor:op="fuse" oor:type="xs:boolean">
              <value>true</value>
            </prop>
          </node>
        </node>
      </node>
      <node oor:name="Draw" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse" oor:type="xs:string">
          <value>notebookbar.ui</value>
        </prop>
        <node oor:name="Modes">
          <node oor:name="Tabbed" oor:op="fuse">
            <prop oor:name="HasMenubar" oor:op="fuse" oor:type="xs:boolean">
              <value>true</value>
            </prop>
          </node>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- 3. 모던 컬러 벡터 아이콘(Sukapura SVG) + 2026 플루언트 라이트 테마 활성화 -->
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <prop oor:name="SymbolStyle" oor:op="fuse" oor:type="xs:string">
        <value>sukapura_svg</value>
      </prop>
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse" oor:type="xs:boolean">
        <value>false</value>
      </prop>
      <prop oor:name="ShowDonation" oor:op="fuse" oor:type="xs:boolean">
        <value>false</value>
      </prop>
    </node>
    <node oor:name="Appearance">
      <prop oor:name="LibreOfficeTheme" oor:op="fuse" oor:type="xs:short">
        <value>1</value>
      </prop>
      <prop oor:name="ApplicationAppearance" oor:op="fuse" oor:type="xs:short">
        <value>1</value>
      </prop>
    </node>
  </oor:component-data>

  <!-- 4. 웰페어고 모던 2026 라이트 블루-화이트 테마 팔레트 (WelfaregoModern) -->
  <oor:component-data oor:name="UI" oor:package="org.openoffice.Office">
    <node oor:name="ColorScheme">
      <prop oor:name="CurrentColorScheme" oor:op="fuse" oor:type="xs:string">
        <value>WelfaregoModern</value>
      </prop>
      <node oor:name="ColorSchemes">
        <node oor:name="WelfaregoModern" oor:op="replace">
          <node oor:name="DocColor"><prop oor:name="Color" oor:type="xs:int"><value>16777215</value></prop></node>
          <node oor:name="AppBackground"><prop oor:name="Color" oor:type="xs:int"><value>15331063</value></prop></node>
          <node oor:name="WindowColor"><prop oor:name="Color" oor:type="xs:int"><value>16777215</value></prop></node>
          <node oor:name="WindowTextColor"><prop oor:name="Color" oor:type="xs:int"><value>1319229</value></prop></node>
          <node oor:name="BaseColor"><prop oor:name="Color" oor:type="xs:int"><value>11912671</value></prop></node>
          <node oor:name="FaceColor"><prop oor:name="Color" oor:type="xs:int"><value>16119804</value></prop></node>
          <node oor:name="ButtonColor"><prop oor:name="Color" oor:type="xs:int"><value>15594236</value></prop></node>
          <node oor:name="ButtonTextColor"><prop oor:name="Color" oor:type="xs:int"><value>1319229</value></prop></node>
          <node oor:name="AccentColor"><prop oor:name="Color" oor:type="xs:int"><value>2183624</value></prop></node>
          <node oor:name="ActiveColor"><prop oor:name="Color" oor:type="xs:int"><value>2183624</value></prop></node>
          <node oor:name="ActiveTextColor"><prop oor:name="Color" oor:type="xs:int"><value>16777215</value></prop></node>
          <node oor:name="ActiveBorderColor"><prop oor:name="Color" oor:type="xs:int"><value>2183624</value></prop></node>
          <node oor:name="FieldColor"><prop oor:name="Color" oor:type="xs:int"><value>16777215</value></prop></node>
          <node oor:name="SeparatorColor"><prop oor:name="Color" oor:type="xs:int"><value>14016494</value></prop></node>
          <node oor:name="ShadowColor"><prop oor:name="Color" oor:type="xs:int"><value>13358561</value></prop></node>
          <node oor:name="DisabledColor"><prop oor:name="Color" oor:type="xs:int"><value>13358561</value></prop></node>
          <node oor:name="DisabledTextColor"><prop oor:name="Color" oor:type="xs:int"><value>9741240</value></prop></node>
          <node oor:name="MenuBarColor"><prop oor:name="Color" oor:type="xs:int"><value>15659771</value></prop></node>
          <node oor:name="MenuBarTextColor"><prop oor:name="Color" oor:type="xs:int"><value>1319229</value></prop></node>
          <node oor:name="MenuBarHighlightColor"><prop oor:name="Color" oor:type="xs:int"><value>14477050</value></prop></node>
          <node oor:name="MenuBarHighlightTextColor"><prop oor:name="Color" oor:type="xs:int"><value>1523102</value></prop></node>
          <node oor:name="MenuColor"><prop oor:name="Color" oor:type="xs:int"><value>16777215</value></prop></node>
          <node oor:name="MenuTextColor"><prop oor:name="Color" oor:type="xs:int"><value>1319229</value></prop></node>
          <node oor:name="MenuHighlightColor"><prop oor:name="Color" oor:type="xs:int"><value>15068927</value></prop></node>
          <node oor:name="MenuHighlightTextColor"><prop oor:name="Color" oor:type="xs:int"><value>1523102</value></prop></node>
          <node oor:name="MenuBorderColor"><prop oor:name="Color" oor:type="xs:int"><value>13358561</value></prop></node>
          <node oor:name="InactiveColor"><prop oor:name="Color" oor:type="xs:int"><value>15002357</value></prop></node>
          <node oor:name="InactiveTextColor"><prop oor:name="Color" oor:type="xs:int"><value>5991301</value></prop></node>
          <node oor:name="InactiveBorderColor"><prop oor:name="Color" oor:type="xs:int"><value>13358561</value></prop></node>
        </node>
      </node>
    </node>
  </oor:component-data>
</oor:data>
